# Ignore everything in the root directory
*

# Allow the src directory and its contents
!/src/
!/src/**

# Optional: Ensure your .gitignore file itself is tracked
!.gitignore

!/.git/
!/.git/**

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
